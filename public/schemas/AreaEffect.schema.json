{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AreaEffect.schema.json",
  "title": "AreaEffect",
  "x-group": "Shared",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "shape": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "x": {
      "type": "integer"
    },
    "y": {
      "type": "integer"
    },
    "zIndex": {
      "type": "integer"
    },
    "opacity": {
      "type": "number"
    },
    "angle": {
      "type": "number"
    },
    "radius": {
      "type": "number"
    },
    "length": {
      "type": "number"
    },
    "width": {
      "type": "number"
    },
    "asset": {
      "$ref": "Asset.schema.json"
    },
    "source": {
      "$ref": "Token.schema.json"
    },
    "reference": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean"
    },
    "locked": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "Component.schema.json"
      }
    }
  },
  "required": [
    "id",
    "shape",
    "color",
    "x",
    "y",
    "zIndex",
    "opacity",
    "angle",
    "radius",
    "length",
    "width",
    "asset",
    "source",
    "reference",
    "hidden",
    "locked",
    "components"
  ],
  "additionalProperties": false,
  "$defs": {
    "Shape": {
      "title": "Shape",
      "type": "string",
      "enum": [
        "cone",
        "cube",
        "cylinder",
        "line",
        "square",
        "sphere"
      ]
    }
  }
}
