{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TableColumn.schema.json",
  "title": "TableColumn",
  "x-group": "Shared",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "alignment": {
      "type": "string"
    },
    "size": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "Alignment": {
      "title": "Alignment",
      "type": "string",
      "enum": [
        "left",
        "right",
        "center"
      ]
    }
  }
}
