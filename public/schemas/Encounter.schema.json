{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Encounter.schema.json",
  "title": "Encounter",
  "x-group": "Content/",
  "type": "object",
  "description": "An Encounter",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "descr": {
      "type": "string"
    },
    "combatants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "parentId": {
      "type": "string"
    },
    "rank": {
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "slug",
    "descr",
    "parentId",
    "rank"
  ],
  "additionalProperties": false,
  "$defs": {
    "Combatant": {
      "title": "Combatant",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "$ref": "Role.schema.json"
        },
        "reference": {
          "type": "string"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "center": {
          "$comment": "unmapped Swift type: CGPoint"
        }
      },
      "additionalProperties": false
    }
  }
}
