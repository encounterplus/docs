{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Combatant.schema.json",
  "title": "Combatant",
  "x-group": "API/",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "$ref": "Role.schema.json"
    },
    "hidden": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "initiative": {
      "type": "array",
      "items": {
        "$ref": "Initiative.schema.json"
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "attributes": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "reference": {
      "type": "string"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "$ref": "Modifier.schema.json"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "StatusEffect.schema.json"
      }
    },
    "bloodied": {},
    "defeated": {},
    "player": {},
    "image": {},
    "entityId": {
      "type": "string"
    },
    "entityType": {
      "$comment": "unmapped Swift type: EntityType"
    },
    "tokenId": {}
  },
  "required": [
    "id",
    "initiative",
    "attributes",
    "modifiers",
    "effects",
    "bloodied",
    "defeated",
    "player",
    "image",
    "tokenId"
  ],
  "additionalProperties": false
}
