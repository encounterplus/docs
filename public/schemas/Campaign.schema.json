{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Campaign.schema.json",
  "title": "Campaign",
  "x-group": "Shared",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "system": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "descr": {
      "type": "string"
    },
    "shortDescr": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "banner": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "attributes": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "systemVersion": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "slug",
    "tags",
    "references",
    "attributes"
  ],
  "additionalProperties": false
}
