{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "System.schema.json",
  "title": "System",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "descr": {
      "type": "string"
    },
    "shortDescr": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "shortName": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "banner": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "attributes": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "descr",
    "shortDescr",
    "author",
    "shortName",
    "website",
    "repository",
    "package",
    "image",
    "banner",
    "data",
    "attributes"
  ],
  "additionalProperties": false
}
