{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TableRoll.schema.json",
  "title": "TableRoll",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "formula": {
      "type": "string"
    },
    "result": {
      "type": "integer"
    },
    "details": {
      "type": "array",
      "items": {
        "$ref": "TableRollDetail.schema.json"
      }
    },
    "reference": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false
}
