{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ExternalScreen.schema.json",
  "title": "ExternalScreen",
  "type": "object",
  "properties": {
    "overlayImage": {
      "type": "string"
    },
    "overlayHandoutText": {
      "type": "string"
    },
    "overlayHandoutStyle": {
      "$ref": "HandoutStyle.schema.json"
    },
    "combatLabels": {
      "$ref": "#/$defs/CombatLabels"
    },
    "interaction": {},
    "sharedVision": {},
    "tableTopMode": {},
    "scrollLock": {},
    "width": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "overlayImage",
    "overlayHandoutText",
    "overlayHandoutStyle",
    "combatLabels",
    "interaction",
    "sharedVision",
    "tableTopMode",
    "scrollLock",
    "width",
    "height",
    "title"
  ],
  "additionalProperties": false,
  "$defs": {
    "OverlayType": {
      "title": "OverlayType",
      "type": "string",
      "enum": [
        "none",
        "image",
        "handout"
      ]
    },
    "CombatStyle": {
      "title": "CombatStyle",
      "type": "string",
      "enum": [
        "flow",
        "detail",
        "grid",
        "top",
        "bottom",
        "left",
        "right",
        "none"
      ]
    },
    "CombatLabels": {
      "title": "CombatLabels",
      "type": "string",
      "enum": [
        "all",
        "monsters",
        "players",
        "none"
      ]
    },
    "RemoteInteraction": {
      "title": "RemoteInteraction",
      "type": "string",
      "enum": [
        "none",
        "token",
        "all"
      ]
    },
    "SharedVision": {
      "title": "SharedVision",
      "type": "string",
      "enum": [
        "never",
        "partial",
        "always"
      ]
    }
  }
}
