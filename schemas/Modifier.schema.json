{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Modifier.schema.json",
  "title": "Modifier",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "attribute": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    }
  },
  "required": [
    "id",
    "enabled",
    "name",
    "mode",
    "attribute",
    "value",
    "scope"
  ],
  "additionalProperties": false,
  "$defs": {
    "Mode": {
      "title": "Mode",
      "type": "string",
      "enum": [
        "override",
        "add",
        "multiply",
        "upgrade",
        "downgrade",
        "custom"
      ]
    },
    "Scope": {
      "title": "Scope",
      "type": "string",
      "enum": [
        "self",
        "global"
      ]
    },
    "ViewModel": {
      "title": "ViewModel",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "attribute": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "id",
        "enabled"
      ],
      "additionalProperties": false
    }
  }
}
