{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Table.schema.json",
  "title": "Table",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "descr": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "type": {},
    "columns": {
      "type": "array",
      "items": {
        "$ref": "TableColumn.schema.json"
      }
    },
    "rows": {
      "type": "string"
    },
    "rollMode": {
      "type": "string"
    },
    "rolls": {
      "type": "string"
    },
    "moduleId": {},
    "campaignId": {},
    "parentId": {},
    "sources": {
      "type": "array",
      "items": {
        "$ref": "Source.schema.json"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "slug",
    "descr",
    "notes",
    "type",
    "columns",
    "rows",
    "rollMode",
    "rolls",
    "moduleId",
    "campaignId",
    "parentId",
    "sources",
    "tags"
  ],
  "additionalProperties": false,
  "$defs": {
    "RollMode": {
      "title": "RollMode",
      "type": "string",
      "enum": [
        "normal",
        "noRepeat",
        "eachRow"
      ]
    }
  }
}
