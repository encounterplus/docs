{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Package.schema.json",
  "title": "Package",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/PackageType"
    },
    "category": {
      "type": "string"
    },
    "system": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "download": {
      "type": "string"
    },
    "compatibility": {
      "$ref": "Compatibility.schema.json"
    },
    "repository": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "$ref": "Author.schema.json"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "type": "boolean"
    },
    "modified": {
      "type": "string"
    },
    "created": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "version",
    "download"
  ],
  "additionalProperties": false,
  "$defs": {
    "PackageType": {
      "title": "PackageType",
      "type": "string",
      "enum": [
        "system",
        "module"
      ]
    }
  }
}
