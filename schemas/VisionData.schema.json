{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VisionData.schema.json",
  "title": "VisionData",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "x": {},
    "y": {},
    "radiusMin": {
      "type": "number"
    },
    "radiusMax": {
      "type": "number"
    },
    "polygon": {
      "type": "array",
      "items": {
        "$comment": "unmapped Swift type: CGPoint"
      }
    },
    "color": {
      "$comment": "unmapped Swift type: CGColor"
    },
    "alwaysVisible": {
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "x",
    "y",
    "radiusMin",
    "radiusMax",
    "polygon",
    "alwaysVisible"
  ],
  "additionalProperties": false
}
