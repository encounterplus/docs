{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TrackedObject.schema.json",
  "title": "TrackedObject",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "typeId": {
      "type": "integer"
    },
    "componentId": {
      "type": "integer"
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "angle": {
      "type": "number"
    },
    "velocityX": {
      "type": "number"
    },
    "velocityY": {
      "type": "number"
    },
    "type": {
      "$ref": "#/$defs/TrackedObjectType"
    },
    "shape": {
      "$ref": "#/$defs/Shape"
    },
    "contour": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "$defs": {
    "TrackedObjectType": {
      "title": "TrackedObjectType",
      "type": "string",
      "enum": [
        "pointer",
        "token"
      ]
    },
    "Shape": {
      "title": "Shape",
      "type": "string",
      "enum": [
        "unknown",
        "circle",
        "rectangle",
        "casetriangle",
        "bladeOfHand"
      ]
    }
  }
}
