{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Aura.schema.json",
  "title": "Aura",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "opacity": {
      "type": "number"
    },
    "radius": {
      "type": "number"
    },
    "asset": {
      "$ref": "Asset.schema.json"
    },
    "reference": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "Component.schema.json"
      }
    }
  },
  "required": [
    "id",
    "enabled",
    "name",
    "color",
    "opacity",
    "radius",
    "asset",
    "reference",
    "components"
  ],
  "additionalProperties": false,
  "$defs": {
    "ViewModel": {
      "title": "ViewModel",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "opacity": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "asset": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "enabled"
      ],
      "additionalProperties": false
    }
  }
}
